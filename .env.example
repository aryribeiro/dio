# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env

# Conexão com o PostgreSQL (o compose.yml já sobe um banco com estas credenciais)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Compila usando os metadados versionados em `.sqlx/`, sem precisar de banco no ar.
# Deixe em `false` quando quiser que o SQLx valide as queries contra o banco real.
SQLX_OFFLINE=true

# Chave que assina os tokens de sessão. Troque por um valor longo e aleatório.
#   openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Chave exigida no header `Authorization` para criar/editar ativos do catálogo.
ADMIN_SECRET=troque-este-valor-tambem
